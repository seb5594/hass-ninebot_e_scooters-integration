--- a/.scripts/package_integration.py
+++ b/.scripts/package_integration.py
@@ -14,7 +14,8 @@
 manifest = json.loads(folders[0].read_text())
 domain, version = manifest["domain"], manifest["version"]
 assert domain == folder.name
